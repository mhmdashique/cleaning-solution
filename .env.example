# Generate a hash with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Generate a random secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=7994342372
NEXT_PUBLIC_WHATSAPP=917994342372

# Supabase Database & Storage Configuration
